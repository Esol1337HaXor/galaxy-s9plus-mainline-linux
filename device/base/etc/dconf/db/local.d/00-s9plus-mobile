# S9+ phone-friendly GNOME defaults (user session, UID 1000).
# Applied live 2026-10-28; configure.sh runs `dconf update` so rebuilds pick these up.
# GNOME Shell 46 on Wayland; Ubuntu Dock (dash-to-dock schema) is already
# dock-position='BOTTOM', dock-fixed=false, dash-max-icon-size=52 by default here.
[org/gnome/desktop/interface]
# No accidental Overview triggers (mouse hot corner) on a touch phone.
enable-hot-corners=false

[org/gnome/shell/extensions/dash-to-dock]
# Dock hidden at all times; reveal with edge swipe from the bottom.
autohide=true
intellihide=false
# Single tap on a running app icon: switch to it, tap again: overview.
click-action='minimize-or-overview'
